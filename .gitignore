# Ignore local application data and persistent databases
**/data/
**/letsencrypt/
**/uptime-kuma-data/

# Ignore sensitive configuration files containing credentials and keys
**/*.env
**/*.key
**/*.pem

# Ignore system-generated and log files
.DS_Store
*.log

node_modules/
**/node_modules/
dist/
build/
.DS_Store
# Wazuh generated secrets — never commit
wazuh/config/wazuh_indexer_ssl_certs/
wazuh/config/wazuh_indexer/internal_users.yml
wazuh/wazuh-agent.deb
wazuh/build-docker-images/
diskont-pos/.env
